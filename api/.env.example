PORT=3001

# Firebase (solo API, no commitear este archivo)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

UPLOADS_DIR=uploads/firmas
MAX_FIRMA_BYTES=5242880

# Solo desarrollo local (Windows + antivirus/proxy). No usar en producción.
# ALLOW_INSECURE_TLS=1

# SendGrid (secreto de servidor — no commitear)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=informes@ineco.ar
SENDGRID_FROM_NAME=Órdenes Ineco

# Auth JWT (obligatorio). Generar un secreto largo y aleatorio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_DAYS=7
# En producción detrás de HTTPS: COOKIE_SECURE=1
COOKIE_SECURE=0
# Primer admin: el email de Google/Microsoft que al entrar queda aprobado como admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Temporal desarrollo: AUTH_DISABLED=1 saltea el login
# AUTH_DISABLED=1

# Medexis (módulo Busca turno)
MEDEXIS_BASE_URL=http://181.14.240.149/medexisws
MEDEXIS_PASSWORD=
MEDEXIS_TOKEN=
