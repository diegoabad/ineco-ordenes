rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Todo el acceso es vía API Express (JWT + roles/módulos).
    // El SDK cliente del servidor no usa Auth → allow if true.
    //
    // ordenes_usuarios/{id}:
    //   email, nombre, role (user|admin), modules[], status (pending|approved|rejected)
    // ordenes_config/auth:
    //   allowedDomains[]
    // ordenes_config/busca_turno:
    //   config compartida del módulo Busca turno
    // ordenes_pedidos_sistema/{id}:
    //   pedidos internos (titulo, detalle, estado, prioridad, fotos)
    // ordenes_inicio_items/{id}:
    //   tareas, notas y recordatorios personales (tipo, titulo, userId, fechaHora, hecha)
    // Módulos: inicio | ordenes | presupuestos | pami | busca-turno | pedidos-sistema | usuarios

    match /ordenes_usuarios/{userId} {
      allow read, write: if true;
    }

    match /ordenes_medicos/{docId} {
      allow read, write: if true;
    }

    match /ordenes_pacientes/{docId} {
      allow read, write: if true;
    }

    match /ordenes_config/{docId} {
      allow read, write: if true;
    }

    match /ordenes_email_envios/{docId} {
      allow read, write: if true;
    }

    match /presupuestos_prestaciones/{docId} {
      allow read, write: if true;
    }

    match /presupuestos_emitidos/{docId} {
      allow read, write: if true;
    }

    match /presupuestos_config/{docId} {
      allow read, write: if true;
    }

    match /pami_analisis/{docId} {
      allow read, write: if true;
    }

    match /ordenes_pedidos_sistema/{docId} {
      allow read, write: if true;
    }

    match /ordenes_inicio_items/{docId} {
      allow read, write: if true;
    }
  }
}
