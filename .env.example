# =============================================================================
# SERVIDOR / CONTENEDOR (docker compose)
# =============================================================================
# Copiá este archivo a .env en el servidor (junto a docker-compose.yml).
# Secretos de RUNTIME. NUNCA subir a GitLab CI ni commitear.
# Comando: docker compose pull && docker compose up -d
# =============================================================================

# --- Imagen Docker ---
GITLAB_REGISTRY_IMAGE=registry.gitlab.com/ineco/administracion:latest

# --- Puerto público del host ---
APP_PORT=8081

# --- Firebase (API server-side, sin prefijo VITE_) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- Auth JWT / cookies ---
JWT_SECRET=
JWT_DAYS=7
# Producción con HTTPS: 1
COOKIE_SECURE=1

# Primer admin (bypassea lista de dominios al entrar)
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# Microsoft Entra (single-tenant). Vacío = /common
AUTH_MICROSOFT_TENANT_ID=

# --- Firmas en disco ---
MAX_FIRMA_BYTES=5242880

# --- Email (opcional) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# --- Medexis (busca turno) ---
MEDEXIS_BASE_URL=
MEDEXIS_PASSWORD=
MEDEXIS_TOKEN=

# Dominios de email permitidos: se gestionan en la app (Usuarios → Dominios)
# Defaults al crear config: ineco.ar | ineco.com.ar | cites-ineco.com.ar
#
# IMPORTANTE Firebase Authorized domains (sitio web, no email):
# Firebase Console → Authentication → Settings → Authorized domains
# Agregar el host de producción, ej: administracion.ineco.ar
# (localhost ya suele estar). Sin esto el login en prod falla con "dominio no autorizado".
